.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# Raw API responses: large, and re-fetched on demand by the cached HTTP layer.
data/cache/
# The ingested panel itself is small and is committed, so every result in
# results/ can be reproduced without re-fetching anything.
!data/raw/*.parquet

# Packaging and local test artifacts.
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Artefacts of the superseded version. Preserved in git history at the first
# commit, not carried in the working tree: nobody clones this to read the
# outputs of the system it replaced.
archive/
results/archive/
images/archive/
